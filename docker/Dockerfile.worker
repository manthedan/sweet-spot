# A minimal SweetSpot worker image: build your own FROM this, or copy the pip line into your image.
# No ENTRYPOINT: the job definition runs `sweetspot worker`.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY pyproject.toml README.md LICENSE /src/
COPY sweetspot /src/sweetspot
RUN pip install --no-cache-dir /src && rm -rf /src

RUN useradd --uid 10001 --create-home sweetspot
USER sweetspot
WORKDIR /home/sweetspot
